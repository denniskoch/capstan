# Copy to .env next to compose.yaml. Compose loads it for every subcommand,
# so `docker compose logs` and `ps` work without re-exporting anything.

# The docker socket's group on THIS host:
#   stat -c '%g' /var/run/docker.sock
DOCKER_GID=999

# The bearer token the console will present. Generate one with:
#   openssl rand -base64 32 | tr -d '=+/' | cut -c1-43
# Leave CAPSTAN_TOKEN out entirely and capstan will mint one and log it once
# at startup instead.
CAPSTAN_TOKEN=

# Enables start/stop/restart/kill/pause/unpause, docker pull, and deletion of
# containers, images and volumes. Never enables container creation or exec.
# Only 1/true/yes/on count.
CAPSTAN_ALLOW_WRITE=false

# Which published image to run. Defaults to edge (the tip of main). Pin a
# release for anything you care about, e.g. CAPSTAN_TAG=0.1.0
CAPSTAN_TAG=edge

# Extra names for the certificate, comma-separated. Only matters if the
# console verifies normally rather than pinning the fingerprint.
CAPSTAN_TLS_SANS=
